# 应用配置
APP_NAME=z-collection-system
DEBUG=True
ENVIRONMENT=development

# 公开请求调试接收器。默认关闭；开启后会记录并回显未鉴权 POST 的完整内容。
ENABLE_PUBLIC_REQUEST_DUMP=false

# 数据库配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rest_data
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Docker配置
# 部署镜像：GitHub Actions 会发布 Docker Hub 多架构镜像。生产环境建议固定为 sha-<提交短 SHA>
# 而不是长期使用 latest；留空时使用公开默认镜像。
MYSERVICE_BACKEND_IMAGE=lzyyauto/myservice
MYSERVICE_FRONTEND_IMAGE=lzyyauto/myservice-frontend
MYSERVICE_IMAGE_TAG=latest
# 飞书 TOML 的宿主机目录；容器内只读挂载到 /app/config。
MYSERVICE_CONFIG_DIR=./config
# 原文、内部 SQLite 和限量日志的宿主机目录；可写挂载到 /app/data。
MYSERVICE_DATA_DIR=./data

# 数据库持久化目录
POSTGRES_DATA_DIR=/var/lib/postgresql/data

# Bark 配置
BARK_BASE_URL=https://api.day.app
BARK_DEFAULT_DEVICE_KEY=

# Notion 配置
NOTION_TOKEN=
NOTION_SLEEP_DATABASE_ID=
NOTION_WAKE_DATABASE_ID=
# Notion 统一采集投递 worker
NOTION_DELIVERY_POLL_INTERVAL_SECONDS=5
NOTION_DELIVERY_RETRY_DELAY_SECONDS=30
NOTION_DELIVERY_LEASE_SECONDS=300

# 飞书灵感采集（可选，仅 worker 使用）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_URL=https://open.feishu.cn
INSPIRATION_DOC_PATH=data/inspirations.md
# 新版纯采集配置；留空则保留旧单文件入口。
FEISHU_CONFIG_PATH=
# 可选内部 SQLite URL；留空使用 TOML runtime.state_path，启动自动初始化，不依赖 PostgreSQL。
FEISHU_STATE_DATABASE_URL=
